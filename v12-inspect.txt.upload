591-    Random r = new Random();
592-    for (int i = 0; i < sets; i++) {
593-      int left = sets - i - 1;
594-      int low = Math.max(min, remaining - left * max);
595-      int high = Math.min(max, remaining - left * min);
596-      int v = low + (high > low ? r.nextInt(high - low + 1) : 0);
597-      split.add(v);
598-      remaining -= v;
599-    }
600-    return split;
601-  }
